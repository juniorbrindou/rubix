{
  "expo": {
    "name": "Rubix Coach",
    "slug": "rubix",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brindoujunior.rubix"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brindoujunior.rubix",
      "versionCode": 700,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# R8 (actif en SDK 58) retire le constructeur de GLView et GLContext.flush, appelés par réflexion/JNI : la 3D plante au démarrage. https://github.com/expo/expo/issues/51948\n-keep class expo.modules.gl.** { *; }\n# Mise à jour intégrée : garder les modules appelés depuis JavaScript (lancement d'intention, fichiers).\n-keep class expo.modules.intentlauncher.** { *; }\n-keep class expo.modules.filesystem.** { *; }"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
              "./node_modules/@expo-google-fonts/unbounded/500Medium/Unbounded_500Medium.ttf",
              "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/400Regular/AtkinsonHyperlegibleNext_400Regular.ttf",
              "./node_modules/@expo-google-fonts/atkinson-hyperlegible-next/700Bold/AtkinsonHyperlegibleNext_700Bold.ttf"
            ]
          }
        }
      ]
    ],
    "scheme": "rubix",
    "experiments": {
      "typedRoutes": true
    }
  }
}
